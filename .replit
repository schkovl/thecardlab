modules = ["nodejs-24", "postgresql-16"]

# Dev workspace only. Production deploys run from GitHub Actions
# (.github/workflows/api-deploy.yml -> Fly.io); do not deploy from Replit.

[workflows]
runButton = "Website Dev"

[[workflows.workflow]]
name = "Website Dev"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --dir artifacts/thecardlab dev"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 80

[nix]
channel = "stable-25_05"
